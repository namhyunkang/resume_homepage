# 관리자 로그인 비밀번호 (길게!)
ADMIN_PASSWORD=change-me-to-something-long

# 세션 서명용 랜덤 문자열 (32자 이상). 예: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# Upstash Redis — Vercel Marketplace에서 Upstash를 연결하면 자동으로 들어옵니다.
# 둘 중 한 쌍만 있으면 됩니다.
KV_REST_API_URL=
